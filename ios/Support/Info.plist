<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleDisplayName</key>
	<string>Jarvis</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Jarvis</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jarvisapp</string>
			</array>
		</dict>
	</array>
	<!-- Kit de Meta para lentes. Con el Modo desarrollador de la app Meta AI no hace falta
	     registrar la app en Meta: MetaAppID en 0 salta esa verificación. -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>jarvisapp://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string></string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>audio</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Jarvis se conecta a tus lentes por Bluetooth.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Jarvis se conecta a tus lentes por Bluetooth.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Jarvis recibe el video de tus lentes y habla con tu servidor en la red local.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Para que puedas hablarle a Jarvis.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Para entender lo que le dices a Jarvis.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Permite hablar con el servidor de tu PC en la red de tu casa (http://192.168...) -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
