# Copia este archivo como .env y llena lo que uses.

# Ruta al stockfish.exe que descargaste
STOCKFISH_PATH=C:\jarvis\stockfish\stockfish-windows-x86-64-avx2.exe
# Segundos que piensa Stockfish por jugada
STOCKFISH_TIME=0.3

# Modelo local de Ollama (con una RTX 3060 va bien uno de 8B)
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# Telegram (opcional): token de @BotFather y tu id de usuario
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

PORT=8000

# Si abres Jarvis desde fuera de tu casa (túnel), pon una clave larga y entra con ?key=<clave>
ACCESS_KEY=
